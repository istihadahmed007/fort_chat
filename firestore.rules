rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Private User Accounts (Strictly Owner-Only: No broad reads of email or phone)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);

      match /cards/{cardId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      match /presence/{docId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      match /blocklist/{blockedUserId} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == blockedUserId);
        allow write: if isOwner(userId);
      }
    }

    // Minimal Public Discovery Profiles (Safe fields only, no private emails or raw phone numbers)
    match /public_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Unique Fort ID Registry
    match /fort_ids/{cleanFortId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 2. End-to-End Encrypted Message Packets
    match /messages/{messageId} {
      allow create: if isAuthenticated() 
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.recipientUserId is string
        && request.resource.data.recipientUserId != request.auth.uid
        && request.resource.data.ciphertextBase64 is string
        && request.resource.data.ivBase64 is string
        && request.resource.data.ephemeralKeyBase64 is string
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)/blocklist/$(request.auth.uid));

      allow read: if isAuthenticated() 
        && (resource.data.recipientUserId == request.auth.uid || resource.data.senderUserId == request.auth.uid);
      
      // Controlled updates for receipts, reactions, edits, and deletions
      allow update: if isAuthenticated() && (
        // Recipient can update delivery or read status
        (resource.data.recipientUserId == request.auth.uid 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryStatus', 'readAt']))
        // Participants can append or modify reactions
        || ((resource.data.recipientUserId == request.auth.uid || resource.data.senderUserId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionsJson']))
        // Sender can edit message content or soft-delete
        || (resource.data.senderUserId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ciphertextBase64', 'ivBase64', 'senderSignatureBase64', 'isEdited', 'isDeleted']))
      );

      allow delete: if isAuthenticated() && resource.data.senderUserId == request.auth.uid;
    }

    // 3. Contact Passes & Bounded Invitations
    // Anti-scraping: only issuer and claimant can read full pass document
    match /contact_passes/{passId} {
      allow read: if isAuthenticated() && (
        resource.data.issuerUserId == request.auth.uid || 
        resource.data.claimantUserId == request.auth.uid
      );

      allow create: if isAuthenticated() 
        && request.resource.data.issuerUserId == request.auth.uid
        && request.resource.data.isRevoked == false
        && request.resource.data.isClaimed == false;

      allow update: if isAuthenticated() && (
        // Issuer can revoke
        (resource.data.issuerUserId == request.auth.uid 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRevoked']) 
          && request.resource.data.isRevoked == true)
        // Claimant can claim active, unclaimed, unexpired pass (atomic single-use enforcement)
        || (
          resource.data.isRevoked == false
          && request.time.toMillis() < resource.data.expiresAt
          && (!resource.data.isSingleUse || resource.data.isClaimed == false)
          && (!resource.data.isClaimed || resource.data.claimantUserId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isClaimed', 'claimantUserId'])
          && request.resource.data.isClaimed == true
          && request.resource.data.claimantUserId == request.auth.uid
          && !exists(/databases/$(database)/documents/users/$(resource.data.issuerUserId)/blocklist/$(request.auth.uid))
        )
      );

      allow delete: if isAuthenticated() && resource.data.issuerUserId == request.auth.uid;
    }

    // Secure Single-Use Pass Token Claims (Keyed by SHA-256 hash of token to prevent collection scraping)
    match /pass_tokens/{tokenHash} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() 
        && request.resource.data.issuerUserId == request.auth.uid
        && request.resource.data.isRevoked == false
        && request.resource.data.isClaimed == false;

      allow update: if isAuthenticated() && (
        (resource.data.issuerUserId == request.auth.uid 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRevoked']))
        || (
          resource.data.isRevoked == false
          && request.time.toMillis() < resource.data.expiresAt
          && (!resource.data.isSingleUse || resource.data.isClaimed == false)
          && (!resource.data.isClaimed || resource.data.claimantUserId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isClaimed', 'claimantUserId'])
          && request.resource.data.isClaimed == true
          && request.resource.data.claimantUserId == request.auth.uid
          && !exists(/databases/$(database)/documents/users/$(resource.data.issuerUserId)/blocklist/$(request.auth.uid))
        )
      );

      allow delete: if isAuthenticated() && resource.data.issuerUserId == request.auth.uid;
    }

    // 4. Knock First Inbound Requests
    match /knock_first/{requestId} {
      allow create: if isAuthenticated()
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.recipientUserId is string
        && request.resource.data.recipientUserId != request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)/blocklist/$(request.auth.uid));
      
      allow read: if isAuthenticated()
        && (resource.data.recipientUserId == request.auth.uid || resource.data.senderUserId == request.auth.uid);

      allow update: if isAuthenticated() 
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if isAuthenticated()
        && (resource.data.recipientUserId == request.auth.uid || resource.data.senderUserId == request.auth.uid);
    }

    // 5. Private Rooms
    match /rooms/{roomId} {
      allow read: if isAuthenticated() 
        && (request.auth.uid in resource.data.members || resource.data.creatorId == request.auth.uid || (resource.data.adminIds is list && request.auth.uid in resource.data.adminIds));
      
      allow create: if isAuthenticated() 
        && request.resource.data.creatorId == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      allow update: if isAuthenticated() && (
        (resource.data.creatorId == request.auth.uid || (resource.data.adminIds is list && request.auth.uid in resource.data.adminIds))
        || (request.auth.uid in resource.data.members 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasksJson']))
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && !(request.auth.uid in request.resource.data.members))
      );

      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // 6. Mood Ring & Quiet Presence
    match /moods/{userId} {
      allow create, update: if isOwner(userId) 
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.emotion in ['ANGRY', 'HAPPY', 'SAD', 'STRESSED', 'READY_TO_TALK', 'NEED_QUIET']
        && request.resource.data.audienceType in ['PRIVATE', 'CONNECTIONS', 'SELECTED_PEOPLE', 'CIRCLES'];
      
      allow delete: if isOwner(userId);

      allow read: if isAuthenticated() 
        && request.time.toMillis() < resource.data.expiresAt
        && (
          isOwner(userId)
          || (resource.data.audienceType == 'CONNECTIONS' 
            && !exists(/databases/$(database)/documents/users/$(userId)/blocklist/$(request.auth.uid)))
          || (resource.data.allowedAudienceIds is list && request.auth.uid in resource.data.allowedAudienceIds)
        );
    }

    // 7. WebRTC Audio & Video Call Signaling
    match /calls/{callId} {
      allow create: if isAuthenticated()
        && request.resource.data.callerUserId == request.auth.uid
        && request.resource.data.receiverUserId is string
        && request.resource.data.receiverUserId != request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.receiverUserId)/blocklist/$(request.auth.uid));

      allow read: if isAuthenticated()
        && (resource.data.callerUserId == request.auth.uid || resource.data.receiverUserId == request.auth.uid);

      // Caller can update offer/status; receiver can update answer/status. Participant IDs cannot be changed.
      allow update: if isAuthenticated() && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['callerUserId', 'receiverUserId', 'callId', 'callType'])
        && (
          (resource.data.callerUserId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'offerSdp'])) ||
          (resource.data.receiverUserId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answerSdp']))
        )
      );

      allow delete: if isAuthenticated()
        && (resource.data.callerUserId == request.auth.uid || resource.data.receiverUserId == request.auth.uid);

      // ICE candidates strictly restricted to the caller and receiver of this specific call
      match /candidates/{candidateId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerUserId == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.receiverUserId == request.auth.uid
        );

        allow create: if isAuthenticated() && (
          (get(/databases/$(database)/documents/calls/$(callId)).data.callerUserId == request.auth.uid && request.resource.data.isCaller == true) ||
          (get(/databases/$(database)/documents/calls/$(callId)).data.receiverUserId == request.auth.uid && request.resource.data.isCaller == false)
        );

        allow update, delete: if false;
      }
    }

    // 8. Ephemeral Private Live Location Sharing
    match /live_locations/{shareId} {
      allow create: if isAuthenticated()
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.recipientUserId is string
        && request.resource.data.expiresAt > request.time.toMillis();

      allow read: if isAuthenticated()
        && (resource.data.senderUserId == request.auth.uid || resource.data.recipientUserId == request.auth.uid)
        && (!resource.data.isStopped)
        && request.time.toMillis() < resource.data.expiresAt;

      allow update: if isAuthenticated()
        && resource.data.senderUserId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderUserId', 'recipientUserId', 'shareId']);

      allow delete: if isAuthenticated()
        && (resource.data.senderUserId == request.auth.uid || resource.data.recipientUserId == request.auth.uid);
    }
  }
}
