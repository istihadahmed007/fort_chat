rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles & Persona Cards
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);

      match /cards/{cardId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      match /blocklist/{blockedUserId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. End-to-End Encrypted Message Packets
    match /messages/{messageId} {
      allow create: if isAuthenticated() 
        && request.resource.data.senderUserId == request.auth.uid
        && request.resource.data.recipientUserId is string
        && request.resource.data.ciphertextBase64 is string
        && request.resource.data.ivBase64 is string
        && request.resource.data.ephemeralKeyBase64 is string
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)/blocklist/$(request.auth.uid));

      allow read: if isAuthenticated() 
        && (resource.data.recipientUserId == request.auth.uid || resource.data.senderUserId == request.auth.uid);
      
      // Controlled updates for receipts, reactions, edits, and deletions
      allow update: if isAuthenticated() && (
        // Recipient can update delivery or read status
        (resource.data.recipientUserId == request.auth.uid 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryStatus', 'readAt']))
        // Participants can append or modify reactions
        || ((resource.data.recipientUserId == request.auth.uid || resource.data.senderUserId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionsJson']))
        // Sender can edit message content or soft-delete
        || (resource.data.senderUserId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ciphertextBase64', 'ivBase64', 'senderSignatureBase64', 'isEdited', 'isDeleted']))
      );

      allow delete: if isAuthenticated() && resource.data.senderUserId == request.auth.uid;
    }

    // 3. Contact Passes & Bounded Invitations
    // Enforces single-use token atomicity and deterministic revocation
    match /contact_passes/{passId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.issuerUserId == request.auth.uid
        && request.resource.data.isRevoked == false
        && request.resource.data.isClaimed == false;

      allow update: if isAuthenticated() && (
        // Issuer can revoke
        (resource.data.issuerUserId == request.auth.uid 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRevoked']) 
          && request.resource.data.isRevoked == true)
        // Claimant can claim active, unclaimed, unexpired pass (atomic single-use enforcement)
        || (
          resource.data.isRevoked == false
          && request.time.toMillis() < resource.data.expiresAt
          && (!resource.data.isSingleUse || resource.data.isClaimed == false)
          && (!resource.data.isClaimed || resource.data.claimantUserId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isClaimed', 'claimantUserId'])
          && request.resource.data.isClaimed == true
          && request.resource.data.claimantUserId == request.auth.uid
          && !exists(/databases/$(database)/documents/users/$(resource.data.issuerUserId)/blocklist/$(request.auth.uid))
        )
      );

      allow delete: if isAuthenticated() && resource.data.issuerUserId == request.auth.uid;
    }

    // 4. Knock First Inbound Requests
    match /knock_first/{requestId} {
      allow create: if isAuthenticated()
        && request.resource.data.senderUserId == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)/blocklist/$(request.auth.uid));
      
      allow read: if isAuthenticated()
        && (resource.data.recipientUserId == request.auth.uid || resource.data.senderUserId == request.auth.uid);

      allow update: if isAuthenticated() 
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if isAuthenticated()
        && (resource.data.recipientUserId == request.auth.uid || resource.data.senderUserId == request.auth.uid);
    }

    // 5. Private Rooms
    // Ephemeral lifecycle-bound rooms: member cannot arbitrarily edit membership or grant access
    match /rooms/{roomId} {
      allow read: if isAuthenticated() 
        && (request.auth.uid in resource.data.members || resource.data.creatorId == request.auth.uid || (resource.data.adminIds is list && request.auth.uid in resource.data.adminIds));
      
      allow create: if isAuthenticated() 
        && request.resource.data.creatorId == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      allow update: if isAuthenticated() && (
        // Only admin or creator can edit members, admins, purpose, or close room
        (resource.data.creatorId == request.auth.uid || (resource.data.adminIds is list && request.auth.uid in resource.data.adminIds))
        // Regular members can ONLY update shared task checklist
        || (request.auth.uid in resource.data.members 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasksJson']))
        // Member can leave room (remove themselves only)
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && !(request.auth.uid in request.resource.data.members))
      );

      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // 6. Mood Ring & Quiet Presence
    match /moods/{userId} {
      allow create, update: if isOwner(userId) 
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.emotion in ['ANGRY', 'HAPPY', 'SAD', 'STRESSED', 'READY_TO_TALK', 'NEED_QUIET']
        && request.resource.data.audienceType in ['PRIVATE', 'CONNECTIONS', 'SELECTED_PEOPLE', 'CIRCLES'];
      
      allow delete: if isOwner(userId);

      allow read: if isAuthenticated() 
        && request.time.toMillis() < resource.data.expiresAt
        && (
          isOwner(userId)
          || (resource.data.audienceType == 'CONNECTIONS' 
            && !exists(/databases/$(database)/documents/users/$(userId)/blocklist/$(request.auth.uid)))
          || (resource.data.allowedAudienceIds is list && request.auth.uid in resource.data.allowedAudienceIds)
        );
    }
  }
}
